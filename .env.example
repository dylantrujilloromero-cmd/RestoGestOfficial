# Copia este archivo a ".env" y completa los valores (".env" NO se sube a Git)

# Neon -> Dashboard -> Connect -> cadena de conexión (con ?sslmode=require)
DATABASE_URL=postgresql://usuario:clave@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require

# Texto largo y aleatorio. Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia-esto-por-un-secreto-largo